# ===== WABA Panel 2026 (NodeJS) - Backend Environment =====
NODE_ENV=production
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/wabapanel

# Auth secrets - CHANGE THESE to long random strings
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_long_random_secret

# Public URLs of your installation
FRONTEND_URL=https://panel.yourdomain.com
BACKEND_URL=https://panel.yourdomain.com
ADMIN_URL=https://panel.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# WhatsApp Cloud API webhook verify token (any string you choose)
WHATSAPP_VERIFY_TOKEN=my_webhook_verify_token

# Panel version (leave as-is; the updater uses this)
PANEL_VERSION=combined-fix-v120-ig-connect-diagnostics-20260809
